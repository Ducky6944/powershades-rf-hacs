# Secrets / local credentials (never commit)
.env
.env.*
*.credentials
credentials.json

# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Testing / coverage
.htmlcov/
.coverage
.pytest_cache/

# Session transcripts
/transcripts/

# Live-captured dashboard debug dumps (contain account secrets — do not commit)
references/dash_*.html
references/dash_*.js
references/dash_probe.sh

# Keep tracked icons, ignore OS clutter
!custom_components/*/icons.png
